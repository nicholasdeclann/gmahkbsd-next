# Never use the local demo password in production.
ADMIN_PASSWORD=
# At least 32 random characters; changing it invalidates sessions.
ADMIN_SECRET=
# Development-only: local JSON fixtures, never used in production builds.
DASHBOARD_DEMO_MODE=false
# In local practice mode, true connects Kertas Acara and prayer management to live Sheets/Drive.
GOOGLE_SHEETS_LIVE_MODE=false
# JSON credentials for a service account shared as Editor on the liturgy workbook.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Keep false until the target spreadsheet has been checked (prefer a test copy).
GOOGLE_SHEETS_WRITES_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_BASE_URL=http://localhost:3000
# Dedicated announcement folder, shared as Viewer with the service account above.
GOOGLE_DRIVE_FOLDER_ID=
# Optional shared server-side connection. Never prefix secrets with NEXT_PUBLIC_.
GOOGLE_DRIVE_REFRESH_TOKEN=
# Private JSON file owned by the church, shared only with the dashboard service account as Editor.
# Names live in Kertas Acara B50:B53; reasons never go into the public workbook.
GOOGLE_PRAYER_NOTES_FILE_ID=
# Optional legacy photo metadata only. Prayer management uses Sheets and Drive.
# New announcements store their description and department directly in Drive.
POSTGRES_URL=

# Optional dedicated events root, shared as Viewer with the service account.
# If empty, the dashboard creates Kegiatan Jemaat inside GOOGLE_DRIVE_FOLDER_ID.
GOOGLE_EVENTS_FOLDER_ID=
